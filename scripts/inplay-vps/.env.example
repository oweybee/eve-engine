# MaxEdge in-play worker — copy to .env and fill in.
#   cp scripts/inplay-vps/.env.example scripts/inplay-vps/.env
# loop.sh sources this file, so systemd picks it up too (no EnvironmentFile needed).

# ── Required ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_FOOTBALL_KEY=

# ── Loop cadence ────────────────────────────────────────────────────────────
# 30s is the point of this worker — GitHub Actions can't go near it.
INPLAY_INTERVAL_SEC=30

# ── Live statistics (possession / shots / corners / cards / xG) ──────────────
# In-play stats move on the order of a minute, so re-polling faster only burns
# quota. Each fixture is skipped until its stats are this stale.
LIVE_STATS_REFRESH_SECONDS=90
# Safety cap on fixtures refreshed per tick (stalest first).
LIVE_STATS_MAX_FIXTURES=30

# ── Multi-book live prices (The Odds API) — optional ────────────────────────
# Without this the live chart has only API-Football's single aggregated feed, so
# there's no consensus-vs-best spread to show. Leave blank to skip cleanly.
ODDS_API_KEY=
ODDS_API_REGIONS=uk
ODDS_API_MARKETS_INPLAY=h2h
ODDS_API_MONTHLY_CREDITS=100000
ODDS_API_RESERVE=2000

# ── In-play signal stages ───────────────────────────────────────────────────
# Roll out with these OFF: the worker then only keeps live state + the chart
# fresh, emitting no signals, so you can watch it for a matchday first.
INPLAY_WINPROB_ENABLED=false
INPLAY_MODEL_ENABLED=false
SECOND_HALF_SNIPER_ENABLED=false

# ── Telegram (optional) ─────────────────────────────────────────────────────
# Leave TELEGRAM_INPLAY_CHAT_ID unset and in-play signals are recorded but not
# posted — they never leak into the main pre-match feed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INPLAY_CHAT_ID=
