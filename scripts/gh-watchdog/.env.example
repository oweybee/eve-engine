# MaxEdge GitHub Actions schedule watchdog — copy to .env and fill in.
#   cp scripts/gh-watchdog/.env.example scripts/gh-watchdog/.env
# run.sh sources this file, so systemd picks it up too via EnvironmentFile.
#
# WHY THIS EXISTS: GitHub's `schedule:` trigger is delivered best-effort and
# has been observed dropping for 8-11+ hours under load — 28 Aug 2026,
# engine.yml's schedule went quiet from 05:36 UTC with a fixture kicking off
# in the gap; odds_snapshots was 112 minutes stale at T-26min to kickoff, and
# nothing was queued or stuck, GitHub simply never delivered the trigger.
# workflow_dispatch is a direct API call and is NOT subject to that queue, so
# this checks freshness from a host GitHub does not control and dispatches
# the real pipeline directly when the native cron has evidently not fired.

# ── Required ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fine-grained PAT scoped to oweybee/eve-engine only, with the single
# repository permission "Actions: Read and write". Nothing else needs
# granting — it never touches contents, secrets or any other scope.
GITHUB_TOKEN=

# ── Target ──────────────────────────────────────────────────────────────────
WATCHDOG_GITHUB_OWNER=oweybee
WATCHDOG_GITHUB_REPO=eve-engine
WATCHDOG_GITHUB_REF=main
# Comma-separated workflow filenames to nudge when stale.
# run-inplay.yml has its own dedicated fix (scripts/inplay-vps, a genuinely
# always-on worker) — add it here only as a fallback if that worker is not
# deployed, since GitHub's schedule for it is throttled the same way.
WATCHDOG_WORKFLOWS=engine.yml

# ── Freshness bar ───────────────────────────────────────────────────────────
# Same two-tier rule as the manual health check this replaces: a flat
# ceiling on staleness, tightened once a fixture is close enough that the
# closing-line window is live. Checked every ~10 minutes (see
# gh-watchdog.timer), so both bars carry real margin against the point a
# human would actually need paging about it.
WATCHDOG_STALE_MINUTES=30
WATCHDOG_PREKICKOFF_WINDOW_MINUTES=120
WATCHDOG_PREKICKOFF_STALE_MINUTES=25
